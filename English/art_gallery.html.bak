<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport"content="width=device-width, initial-scale=1.0">
	<title>Alexandra Heydt’s Art Gallery</title>
	<link rel="stylesheet" href="style.css">
</head>
<body>
	<script src="script.js"></script>
	<nav>
		<ul class="nav nav-left">
			<li><a class="space-mono-bold" href="index.html">Portfolio</a></li>
			<li><a class="space-mono-bold" href="art_gallery.html">Art Gallery</a></li>
			<li><a class="space-mono-bold" href="contact.html">Contact</a></li>
			<li><a class="space-mono-bold" href="identities.html">My Identities</a></li>
