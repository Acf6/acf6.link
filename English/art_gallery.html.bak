		<div class="nav">
			<a class="space-mono-bold" href="?lang=en">English</a>
			<a class="space-mono-bold" href="?lang=fr">Français</a>
		</div>
	</nav>
	<section id="selector">
		<p class="space-mono-bold">Filters</p>
		<label for="sketch">
			<input id="sketch" checked type="checkbox" class="check outfit-regular">
		</label>
		<label for="life">
			<input id="life" checked type="checkbox" class="check outfit-regular">
		</label>
	</section>
	<section id="art">
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A girl shushing and looking up at the camera" src="Illustration/Untitled803_20240615214218.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Aveline Karmine by LiteralHat in a cartoon style playing an electic guitar sitting against a wall" src="Illustration/Untitled808.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Starlo from the fangame Undertale Yellow pointing a gun at the camera" src="Illustration/Untitled810_20240609225646.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A woman with her ginger hair and blue dress flowing in the wind" src="Illustration/Untitled847_20240730190240.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Mari from Omori in a cartoon style sitting and looking at the camera" src="Illustration/Mari Finalllllll.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A cartoon girl with explosions in the background" src="Illustration/Untitled791_20240523182155.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Kris from Deltarune pointing their sword at the camera" src="Illustration/Untitled861_20240909124300.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Link from Zelda cooking food in the night" src="Illustration/Untitled668_20230719235708.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A guy laying on the floor in the opposite way of the camera" src="Illustration/Untitled500_20230128211907.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A cartoon girl leaning on something with her hands" src="Illustration/dgdrgregdrgrdgrd.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="Fanart of Marceline from Adventure Time sitting with a leg over another" src="Illustration/Marcy Adventure Timeee.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A sketch of a woman holding something and looking down" src="Illustration/DRGJDOJDROJDROJDR.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A sketch of someone with dynamic long hair in the air pointing down" src="Illustration/Untitled781.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A character design test sheet with a cartoon guy colored in different ways" src="Illustration/hlgvulhvuluhvlhvul.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="An uncolored front-facing character reference sheet" src="Illustration/jnjntyjtyejty,ntyjnty.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A sketch of two dogs facing the camera" src="Illustration/20240505_103737.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A sketch of a dog with his tongue out" src="Illustration/20240505_103658.png">
		</div>
		<div class="image-container">
			<img class="mainimg" tabindex="0" alt="A sketch of a puppy with his tongue out" src="Illustration/20240505_103705.png">
